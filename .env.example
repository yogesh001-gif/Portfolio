# Copy to .env.local for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Contact form (https://resend.com → API Keys)
RESEND_API_KEY=
# Your inbox — where contact messages are delivered
RESEND_TO_EMAIL=
# Optional: a sender on a domain you verified in Resend
RESEND_FROM_EMAIL=

# Optional: custom domain for social previews (Vercel's domain is detected automatically)
VITE_SITE_URL=
